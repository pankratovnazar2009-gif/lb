# Player-of-the-round voting (src/app/api/vote/route.ts) needs a key-value
# store to persist votes across visitors. Without these, the widget still
# works — it just shows "Голосування тимчасово недоступне" instead of saving.
#
# In the Vercel dashboard: Project → Storage → Create Database → KV
# (or the "Upstash for Redis" marketplace integration — same env var names).
# Connecting it to the project injects these automatically in Production/Preview.
#
# For local dev: `vercel link` then `vercel env pull .env.local`, or copy the
# values from the storage product's ".env.local" tab and paste them below.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
